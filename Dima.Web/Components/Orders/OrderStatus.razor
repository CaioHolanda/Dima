@inherits OrderStatusComponent
@switch (Status)
{
    case EOrderStatus.Canceled:
    <MudChip T="string" Color="Color.Error">CANCELADO</MudChip>
        break;

    case EOrderStatus.Paid:

        @if (IsComplimentary)
        {
            <MudChip T="string" Color="Color.Success">
                CONFIRMADO
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Success">
                PAGO
            </MudChip>
        }

        break;

    case EOrderStatus.RefundPending:
        <MudChip T="string" Color="Color.Warning">
            REEMBOLSO EM PROCESSAMENTO
        </MudChip>
        break;

    case EOrderStatus.Refunded:
        <MudChip T="string" Color="Color.Info">REEMBOLSADO</MudChip>
        break;

    case EOrderStatus.WaintingPayment:
        @if (HasElapsed)
        {
            <MudChip T="string" Color="Color.Warning">
                PRAZO ENCERRADO — EM VERIFICAÇÃO
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Warning">
                AGUARDANDO PAGAMENTO
            </MudChip>
        }
        break;

    case EOrderStatus.Expired:
        <MudChip T="string" Color="Color.Default">
            EXPIRADO
        </MudChip>
        break;

    default:
        <MudChip T="string" Color="Color.Info">Nao Identificado</MudChip>
        break;
}


