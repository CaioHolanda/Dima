@inherits OrderActionComponent
@switch (Order.Status)
{
    case EOrderStatus.Paid:

        @if (CanRequestRefund)
        {
            <MudButton FullWidth="true"
                       Color="Color.Warning"
                       Variant="Variant.Outlined"
                       OnClick="OnRefundButtonClicked">
                SOLICITAR ESTORNO
            </MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">
                Este pedido não está mais disponível para reembolso automático.
            </MudAlert>
        }

        break;

    case EOrderStatus.WaintingPayment:
        <MudButton FullWidth="true" Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Class="mb-4" OnClick="OnPayButtonClickedAsync">
            PAGAR COM STRIPE
        </MudButton>
        <MudButton FullWidth="true" Color="Color.Error" Variant="Variant.Outlined" OnClick="OnCancelButtonClicked">
            CANCELAR O PEDIDO
        </MudButton>
    break;

    default:
        <MudText></MudText>
    break;
}