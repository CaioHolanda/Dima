@inherits OrderActionComponent
@switch (Order.Status)
{
    case EOrderStatus.Paid:

        @if (Order.Gateway ==
             EPaymentGateway.NotApplicable)
        {
            <MudAlert Severity="Severity.Success"
                      Variant="Variant.Outlined">
                Pedido confirmado. Nenhum pagamento foi necessário.
            </MudAlert>
        }
        else if (CanRequestRefund)
        {
            <MudButton FullWidth="true"
                       Color="Color.Warning"
                       Variant="Variant.Outlined"
                       OnClick="OnRefundButtonClicked">
                SOLICITAR ESTORNO
            </MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">
                Este pedido não está mais disponível para reembolso automático.
            </MudAlert>
        }

        break;

    case EOrderStatus.WaintingPayment:
        @if (!Order.ExpiresAt.HasValue)
        {
            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Outlined">
                Não foi possível determinar o prazo deste pedido.
                Entre em contato com o suporte antes de continuar.
            </MudAlert>
        }
        else if (Order.ExpiresAt.Value <= DateTimeOffset.UtcNow)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined">
                O prazo deste pedido terminou e estamos verificando
                a situação do pagamento. Esta página será atualizada
                automaticamente. Se você já pagou, aguarde a confirmação
                antes de tentar outra compra.
            </MudAlert>
        }
        else
        {
            <MudButton FullWidth="true"
                       Color="Color.Success"
                       Variant="Variant.Filled"
                       Size="Size.Large"
                       Class="mb-4"
                       OnClick="OnPayButtonClickedAsync">
                PAGAR COM STRIPE
            </MudButton>

            <MudButton FullWidth="true"
                       Color="Color.Error"
                       Variant="Variant.Outlined"
                       OnClick="OnCancelButtonClicked">
                CANCELAR O PEDIDO
            </MudButton>
        }
        break;
    case EOrderStatus.Expired:
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined">
            O prazo para pagamento deste pedido terminou.
            Faça um novo pedido para continuar.
        </MudAlert>
    break;
    default:
        <MudText></MudText>
    break;
}