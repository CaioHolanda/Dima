@page "/pedidos/{number}/confirmar"
@inherits ConfirmOrderPaymentPage

@if (IsConfirming)
{
    <MudProgressCircular Indeterminate="true"
                         Class="mb-4" />

    <MudText Typo="Typo.h5">
        Confirmando pagamento...
    </MudText>

    <MudText Typo="Typo.body1" Class="mt-2">
        Aguarde enquanto confirmamos seu pagamento.
    </MudText>
}
else if (Order?.Status == EOrderStatus.Paid)
{
    <MudText Typo="Typo.h4">
        Parabens! Pedido confirmado com sucesso
    </MudText>

    <MudText Typo="Typo.body1" Class="mt-2">
        Seu pagamento foi confirmado e seu acesso está disponível.
    </MudText>
}
else if (IsTimedOut)
{
    <MudText Typo="Typo.h5">
        A confirmação está demorando mais que o esperado
    </MudText>

    <MudText Typo="Typo.body1" Class="mt-2 mb-4">
        Lamentamos, ainda não foi possível confirmar o pagamento.
        Você pode verificar novamente sem realizar uma nova compra.
        Se o problema persistir, contate o administrador.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="RetryAsync">
        Verificar novamente
    </MudButton>
}
else
{
    <MudText Typo="Typo.h5">
        Não foi possível concluir a confirmação
    </MudText>

    <MudText Typo="Typo.body1" Class="mt-2">
        O pedido não está mais aguardando confirmação de pagamento.
        Contate o administrador para obter suporte.
    </MudText>
}