@page "/checkout/{productSlug}"
@inherits CheckoutoutPage
<MudContainer Class="mt-16" MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Checkout</MudText>
    <MudGrid Class="mt-16" Justify="Justify.Center">
        <MudItem xs="12" sm="12" md="10" lg="8" xl="6" xxl="5">
            <MudPaper Class="d-flex flex-column" Outlined="true">
                <MudList T="string">
                    <MudListItem Icon="@Icons.Material.Filled.Star">
                        <MudText>@Product?.Title</MudText>
                        <MudText Inline="true" Class="ml-auto">
                            @(Product?.Price.ToString("C"))
                        </MudText>
                    </MudListItem>
                    <MudDivider/>
                    <MudListItem Icon="@(AppliedVoucher is null
                                 ? Icons.Material.Filled.Discount
                                 : Icons.Material.Filled.CheckCircle)">

                        <MudTextField T="string"
                                      Disabled="@IsApplyingVoucher"
                                      ReadOnly="@(AppliedVoucher is not null)"
                                      Placeholder="Cupom de desconto"
                                      @bind-Value="VoucherCode"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(AppliedVoucher is null
                                              ? Icons.Material.Filled.FactCheck
                                              : Icons.Material.Filled.Close)"
                                      OnAdornmentClick="OnVoucherAdornmentClickAsync"
                                      OnKeyDown="OnVoucherKeyDownAsync" />
                    </MudListItem>
                    <MudListItem Icon ="@Icons.Material.Filled.MoneyOff">
                        <div class="d-flex">
                            <MudText>Desconto</MudText>
                            <MudText Class="ml-auto">
                                @DiscountAmount.ToString("C")
                            </MudText>
                        </div>
                    </MudListItem>
                    <MudDivider/>
                    <div class="mt-auto pa-4">
                        <MudText>Total: </MudText>
                        <MudText Class="ml-auto">
                            <strong>
                                @Total.ToString("C")
                            </strong>
                        </MudText>
                    </div>
                </MudList>
            </MudPaper>
            <MudButton @onclick="OnValidSubmitAsync"
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="@(!IsValid || IsBusy || IsApplyingVoucher)"
                DisableElevation="true"
                Size="Size.Large"
                Class="mt-6"
                FullWidth="true">
                @(Total == 0m
                    ? "CONFIRMAR PEDIDO"
                    : "FINALIZAR PEDIDO")
            </MudButton>
        </MudItem>
    </MudGrid>
    
</MudContainer>