@page "/admin/produtos/editar/{Id:long}"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits EditAdminProductPage

<MudText Typo="Typo.h3">
    Editar Produto
</MudText>

@if (IsBusy)
{
    <MudPaper Class="pa-8 mt-4">
        <MudSkeleton Height="55px" />
        <MudSkeleton Height="110px" />
        <MudSkeleton Height="55px" />
        <MudSkeleton Height="55px" />
    </MudPaper>
}
else
{
    <MudPaper Class="pa-8 mt-4">
        <EditForm Model="@InputModel"
                  OnValidSubmit="@OnValidSubmitAsync">
            <DataAnnotationsValidator />

            <MudTextField Label="Produto"
                          HelperText="Campo obrigatório"
                          @bind-Value="InputModel.Title"
                          For="@(() => InputModel.Title)"
                          Immediate="true" />

            <MudTextField Label="Descrição"
                          Lines="3"
                          HelperText="Digite um benefício por linha"
                          @bind-Value="InputModel.Description"
                          For="@(() => InputModel.Description)"
                          Immediate="true" />

            <MudTextField T="decimal"
                          Label="Preço"
                          HelperText="Digite o valor usando vírgula. Exemplo: 30,99"
                          @bind-Value="InputModel.Price"
                          For="@(() => InputModel.Price)"
                          InputType="InputType.Text"
                          Format="0.00"
                          Culture="@BrazilCulture"
                          Immediate="false" />

            <MudNumericField T="int"
                             Label="Duração do acesso (meses)"
                             HelperText="Campo obrigatório. Informe um valor maior que zero"
                             @bind-Value="InputModel.AccessDurationMonths"
                             For="@(() => InputModel.AccessDurationMonths)"
                             Min="1"
                             Immediate="true" />

            <MudTextField T="string"
                          Label="Slug"
                          HelperText="Use letras minúsculas, números e hífens"
                          @bind-Value="InputModel.Slug"
                          For="@(() => InputModel.Slug)"
                          Immediate="true" />

            <MudSwitch T="bool"
                       @bind-Value="InputModel.IsActive"
                       Color="Color.Success">
                Produto ativo
            </MudSwitch>

            <MudStack Row="true"
                      Spacing="2"
                      Class="mt-4">

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <MudProgressCircular Class="mr-2"
                                             Size="Size.Small"
                                             Indeterminate="true" />
                        <MudText>Salvando...</MudText>
                    }
                    else
                    {
                        <MudText>SALVAR</MudText>
                    }
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Href="/admin/produtos"
                           Disabled="@IsSaving">
                    CANCELAR
                </MudButton>

            </MudStack>
        </EditForm>
    </MudPaper>
}