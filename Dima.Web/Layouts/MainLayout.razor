@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeState ThemeState
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar>
                <MudIconButton 
                Icon ="@Icons.Material.Filled.Menu"
                Color ="Color.Inherit"
                Edge="Edge.Start"
                OnClick="ToggleDrawer"/>
                Dima
                <MudButton  Href="/lancamentos/novo" 
                            Variant="Variant.Text"
                            StartIcon="@Icons.Material.TwoTone.Add"
                           Color="Color.Dark"
                           Class="ml-16">
                                Novo Lancamento
                </MudButton>
                <MudSpacer/>
                <MudText Typo="Typo.caption" Class="ml-4">
                    @context.User.Identity?.Name
                </MudText>
                <MudSwitch 
                    Color="Color.Inherit"
                    @bind-Value="ThemeState.IsDarkMode"
                    T="bool"
                    Class="ma-4"
                    ThumbIcon="@Icons.Material.TwoTone.Lightbulb"/>
            </MudAppBar>
            <MudDrawer @bind-Open="@_isDrawerOpened">
                <NavMenu/>
            </MudDrawer>
            <MudMainContent>
                <MudContainer Class="mt-4"
                              MaxWidth="@(IsAdminPage
                                                    ? MaxWidth.False
                                                    : MaxWidth.Large)">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect/>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _isDrawerOpened = true;
    private void ToggleDrawer() => _isDrawerOpened = !_isDrawerOpened;
    private bool IsAdminPage =>
    new Uri(NavigationManager.Uri)
        .AbsolutePath
        .StartsWith(
            "/admin/",
            StringComparison.OrdinalIgnoreCase);
}
